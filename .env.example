# CryptoPulse Environment Configuration
# Copy this file to .env and adjust values for your environment.

# Application
APP_NAME=cryptopulse
ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_FORMAT=json

# Health Server
HEALTH_HOST=0.0.0.0
HEALTH_PORT=8080

# Kafka (KRaft mode)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_PREFIX=cryptopulse
KAFKA_CONSUMER_GROUP=cryptopulse-processing
KAFKA_SESSION_TIMEOUT_MS=45000
KAFKA_ENABLE_AUTO_COMMIT=false

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DATABASE=cryptopulse
POSTGRES_USERNAME=cryptopulse
POSTGRES_PASSWORD=cryptopulse
POSTGRES_MIN_CONNECTIONS=2
POSTGRES_MAX_CONNECTIONS=10

# Prometheus
PROMETHEUS_HOST=0.0.0.0
PROMETHEUS_PORT=9090

# Grafana
GRAFANA_HOST=0.0.0.0
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
